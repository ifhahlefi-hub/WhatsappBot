{
  "name": "whatsapp-daily-assistant",
  "version": "1.0.0",
  "description": "WhatsApp Bot asisten harian personal & produktivitas menggunakan Baileys",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "admin": "node src/server.js",
    "frontend": "cd frontend && npx vite --port 5173",
    "predev": "npx kill-port 3001 5173 || true",
    "dev": "concurrently -k -n BOT,ADMIN,UI -c green,blue,magenta \"cross-env BOT_ONLY=true node src/bot.js\" \"node src/server.js\" \"cd frontend && npx vite --port 5173\"",
    "dev:bot": "node src/bot.js",
    "dev:admin": "node src/server.js",
    "dev:frontend": "cd frontend && npx vite --port 5173",
    "build:frontend": "cd frontend && npm run build",
    "create-super-admin": "node scripts/create-super-admin.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.21",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "kill-port": "^2.0.1"
  }
}
